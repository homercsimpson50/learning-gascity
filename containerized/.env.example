# Copy this file to .env and adjust to taste.
#
# All variables have safe defaults — you can `docker compose up -d` with
# none of them set and get a working container. Set GIT_USER / GIT_EMAIL
# at minimum so your git commits aren't authored by "TestUser".

# --- Identity ---
# Used for git config + dolt config inside the container.
GIT_USER=Your Name
GIT_EMAIL=you@example.com

# --- Coding-agent runtime ---
# What `gc init` registers as the agent runtime. Other valid values:
# codex, gemini, exec. See `gc init --help`.
GC_PROVIDER=claude

# --- Source pin ---
# The gascity repo + ref the image is built from. Override to pin to a
# release tag (e.g. v1.0.1) or a SHA for reproducible rebuilds.
GASCITY_REPO=https://github.com/gastownhall/gascity.git
GASCITY_REF=main

# Image tag to use after build. Override to keep multiple versions side
# by side (e.g. GASCITY_IMAGE_TAG=v1.0.1).
GASCITY_IMAGE_TAG=latest

# --- Host directories ---
# Code directory bind-mounted read-write at /city/rigs-host. Agents add
# rigs out of subdirectories here.
GCC_CODE_DIR=~/code
