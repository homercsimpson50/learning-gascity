#!/usr/bin/env bash
# gc-docker-runner — host-side shim that translates an agent invocation
# from Gas City into a `docker run` against gascity-agent-runner.
#
# Symlinked as `claude` (and optionally `codex`, `gemini`, etc.) earlier
# on PATH than the real binaries. argv[0] decides which agent to launch:
#   /usr/local/bin/claude → reads image[claude] from config
#   /usr/local/bin/codex  → reads image[codex]  from config
#
# Reference: docs/containerizing-gascity-for-local-use-spec.md §3.2, §4.

set -euo pipefail

CONFIG="${GC_DOCKER_RUNNER_CONFIG:-$HOME/.config/gascity-docker-runner/config.toml}"
LOG_DIR="${GC_DOCKER_RUNNER_LOG_DIR:-$HOME/.local/state/gascity-docker-runner/logs}"
SHIM_DIR="${GC_DOCKER_RUNNER_SHIM_DIR:-$HOME/.local/bin/gascity-shims}"

# --- Which agent are we standing in for? -----------------------------------
AGENT_NAME="$(basename "$0")"
case "$AGENT_NAME" in
    claude|codex|gemini) ;;
    *) echo "[gc-docker-runner] FATAL invoked under unsupported name: $AGENT_NAME (expected claude|codex|gemini)" >&2; exit 64 ;;
esac

# --- Passthrough mode ------------------------------------------------------
# Containerize only when this is a rig-scoped agent invocation — gc sets
# GC_RIG (the rig name) and GC_DIR (the agent's worktree path) for those.
# City-scoped agents (mayor, deacon, boot) get neither; their `claude`
# should run on the host. Same for any accidental interactive invocation.
#
# Note: an older draft of the spec used GC_RIG_PATH; the actual gc binary
# exports GC_RIG / GC_RIG_ROOT / GC_DIR. We accept the old name as a
# fallback so anyone who set GC_RIG_PATH manually still gets the docker
# path.
if [ -z "${GC_RIG:-}${GC_RIG_PATH:-}" ]; then
    REAL_BIN_FILE="$SHIM_DIR/.real-$AGENT_NAME"
    if [ ! -f "$REAL_BIN_FILE" ]; then
        echo "[gc-docker-runner] FATAL no real-binary sidecar at $REAL_BIN_FILE — re-run containerized/install.sh" >&2
        exit 64
    fi
    REAL_BIN="$(cat "$REAL_BIN_FILE")"
    if [ ! -x "$REAL_BIN" ]; then
        echo "[gc-docker-runner] FATAL real $AGENT_NAME at $REAL_BIN is missing or not executable" >&2
        echo "[gc-docker-runner]       (claude auto-update may have moved it — re-run containerized/install.sh)" >&2
        exit 64
    fi
    exec "$REAL_BIN" "$@"
fi

mkdir -p "$LOG_DIR"

# --- Parse the (intentionally tiny) TOML config ---------------------------
# We only need a handful of keys; full TOML parsing in pure bash is overkill.
# Sed picks the value for `key = "value"` lines under each [section].
toml_get() {
    # NOTE: BSD awk on macOS reserves `in` as a keyword (array operator).
    # Don't use `in` as a variable — `inside` works in both BSD and GNU awk.
    local section="$1" key="$2"
    awk -v s="$section" -v k="$key" '
        $0 ~ "^\\["s"\\]" {inside=1; next}
        inside && $0 ~ "^\\[" {inside=0}
        inside && $0 ~ "^[[:space:]]*"k"[[:space:]]*=" {
            sub("^[^=]*=[[:space:]]*\"?", ""); sub("\"?[[:space:]]*$", "");
            print; exit
        }
    ' "$CONFIG" 2>/dev/null
}

if [ ! -f "$CONFIG" ]; then
    echo "[gc-docker-runner] FATAL no config at $CONFIG (run install.sh first)" >&2
    exit 64
fi

IMAGE="$(toml_get image "$AGENT_NAME")"
if [ -z "$IMAGE" ]; then
    echo "[gc-docker-runner] FATAL no image configured for agent '$AGENT_NAME' in $CONFIG" >&2
    exit 64
fi

# Fail loud (not silent) if the configured image is missing. Without this
# check, an `exec claude …` invocation would silently exit 0 / 125, which
# is impossible to debug — especially if the shim has been put on a global
# PATH by accident and intercepts the user's normal `claude` use.
if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
    cat >&2 <<EOF
[gc-docker-runner] FATAL image not present: $IMAGE
                   build it with:
                     cd <learning-gascity>/containerized
                     docker build -t $IMAGE agent-runner/
                   or remove the shim from PATH if you didn't mean to use it.
EOF
    exit 125
fi

LIM_MEM="$(toml_get limits memory)"; : "${LIM_MEM:=4g}"
LIM_CPU="$(toml_get limits cpus)";   : "${LIM_CPU:=2}"
LIM_PIDS="$(toml_get limits pids_limit)"; : "${LIM_PIDS:=512}"
TIMEOUT="$(toml_get limits timeout)"; : "${TIMEOUT:=30m}"

# v2: the network is forced to gc-broker-net (--internal). This is the
# whole isolation story — agents have no internet egress and reach
# Anthropic / GitHub only via the brokers. We still read the legacy
# [network] mode key so old configs don't blow up; we just warn if it
# names something other than the v2 network.
LEGACY_NETWORK="$(toml_get network mode)"
NETWORK="gc-broker-net"
if [ -n "$LEGACY_NETWORK" ] && [ "$LEGACY_NETWORK" != "$NETWORK" ] && [ "$LEGACY_NETWORK" != "bridge" ]; then
    echo "[gc-docker-runner] warn: [network] mode=$LEGACY_NETWORK is ignored under v2 (forced to $NETWORK)" >&2
fi

# --- Resolve the rig path --------------------------------------------------
# Mount the agent's per-agent worktree (GC_DIR) at /work — that's the
# scoped sandbox gc set up for this agent, distinct from the rig source
# at GC_RIG_ROOT. Fall back to GC_RIG_PATH (legacy spec env var name).
RIG_PATH="${GC_DIR:-${GC_RIG_PATH:-}}"
if [ -z "$RIG_PATH" ]; then
    echo "[gc-docker-runner] FATAL GC_DIR (and GC_RIG_PATH) are unset — gc must set the agent worktree path" >&2
    exit 64
fi
if [ ! -d "$RIG_PATH" ]; then
    echo "[gc-docker-runner] FATAL agent worktree does not exist: $RIG_PATH" >&2
    exit 64
fi

# --- Container name --------------------------------------------------------
# gc exports GC_AGENT (e.g. "demo-rig/claude-1") and GC_BEAD_ID for a
# bead-backed session. Older specs called these GC_AGENT_NAME / GC_BEAD;
# accept both. Docker container names allow [a-zA-Z0-9_.-], so substitute
# "/" and other forbidden chars for "_".
SAFE_AGENT="${GC_AGENT:-${GC_AGENT_NAME:-anon}}"
SAFE_BEAD="${GC_BEAD_ID:-${GC_BEAD:-nobead}}"
NAME="gc-${SAFE_AGENT//[^a-zA-Z0-9_.-]/_}-${SAFE_BEAD//[^a-zA-Z0-9_.-]/_}"
LOG_FILE="$LOG_DIR/${GC_SESSION_ID:-$$}.log"

# --- Forwarded env (whitelist) --------------------------------------------
# Only forward what the agent + supervisor need. Everything else is dropped.
#
# v2: ANTHROPIC_API_KEY / OPENAI_API_KEY / GOOGLE_API_KEY / CLAUDE_API_KEY
# / GH_TOKEN are NOT in this list. Those credentials live in the broker
# containers; agents reach them via the broker base URLs injected below.
# Forwarding the env vars too would let the agent's CLI prefer them
# (claude-code does ANTHROPIC_API_KEY > ANTHROPIC_BASE_URL+OAuth) and
# bypass the broker entirely.
FORWARD_ENV=(
    GC_RIG
    GC_RIG_ROOT
    GC_RIG_PREFIX
    GC_BEAD_ID
    GC_AGENT
    GC_AGENT_NAME
    GC_SESSION_ID
    GC_TEMPLATE
    GC_PROVIDER
    GC_GIT_USER
    GC_GIT_EMAIL
)
ENV_FLAGS=()
for v in "${FORWARD_ENV[@]}"; do
    if [ -n "${!v:-}" ]; then
        ENV_FLAGS+=( -e "$v" )
    fi
done

# v2: injected env (always set, regardless of host env). These point the
# agent at the brokers on gc-broker-net. The agent has no other route
# off the docker-internal network, so these URLs are the only way it
# can reach Anthropic / GitHub at all.
INJECT_ENV=(
    "ANTHROPIC_BASE_URL=http://gc-broker-anthropic:8080"
    "GITHUB_API_URL=http://gc-broker-github-api:8080"
    "SSH_AUTH_SOCK=/run/sshagent/gc.sock"
    "GIT_SSH_COMMAND=ssh -F /etc/ssh/ssh_config_gc"
)
for kv in "${INJECT_ENV[@]}"; do
    ENV_FLAGS+=( -e "$kv" )
done

# --- docker run ------------------------------------------------------------
# Every flag here has a reason. See spec §4 before stripping anything.
exec_docker() {
    docker run \
        --rm \
        --name "$NAME" \
        --user 1000:1000 \
        --read-only \
        --tmpfs "/tmp:size=512m,mode=1777" \
        --tmpfs "/home/agent/.cache:size=512m" \
        --workdir /work \
        -v "$RIG_PATH:/work:rw,Z" \
        -v "gc-sshagent-sock:/run/sshagent:ro" \
        --network "$NETWORK" \
        --memory="$LIM_MEM" \
        --cpus="$LIM_CPU" \
        --pids-limit="$LIM_PIDS" \
        --cap-drop=ALL \
        --security-opt=no-new-privileges \
        "${ENV_FLAGS[@]}" \
        --interactive \
        $( [ -t 0 ] && echo --tty ) \
        "$IMAGE" \
        "$AGENT_NAME" "$@"
}

# --- Signal forwarding -----------------------------------------------------
# Trap SIGTERM/SIGINT, ask docker to stop the container with a 10s grace,
# then exit. Without this, `gc stop` would TERM the shim but leave the
# container running until the agent process exits naturally.
cleanup() {
    docker stop --time=10 "$NAME" 2>/dev/null || true
}
trap cleanup TERM INT

# --- Run with timeout + tee logs ------------------------------------------
{
    echo "[gc-docker-runner] $(date -u +%FT%TZ) launch agent=$AGENT_NAME bead=${GC_BEAD_ID:-?} session=${GC_SESSION_ID:-?} image=$IMAGE"
    echo "[gc-docker-runner] rig=$RIG_PATH name=$NAME timeout=$TIMEOUT"
} >> "$LOG_FILE"

# Convert "30m" / "2h" / "90s" into a seconds count for `timeout`.
parse_dur() {
    local d="$1" n="${1%[smhd]}" u="${1: -1}"
    case "$u" in
        s) echo "$n" ;;
        m) echo $((n * 60)) ;;
        h) echo $((n * 3600)) ;;
        d) echo $((n * 86400)) ;;
        *) echo "$d" ;;
    esac
}
TIMEOUT_SECS="$(parse_dur "$TIMEOUT")"

if command -v timeout >/dev/null 2>&1; then
    timeout --signal=TERM --kill-after=15s "$TIMEOUT_SECS" \
        bash -c 'exec_docker "$@"' bash "$@" 2>&1 | tee -a "$LOG_FILE"
else
    # macOS: GNU timeout is `gtimeout` from coreutils; if missing we run
    # without a hard timeout and rely on the agent to terminate.
    exec_docker "$@" 2>&1 | tee -a "$LOG_FILE"
fi
RC=${PIPESTATUS[0]}

echo "[gc-docker-runner] $(date -u +%FT%TZ) exit rc=$RC" >> "$LOG_FILE"
exit "$RC"
